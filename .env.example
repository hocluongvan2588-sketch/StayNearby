# Database (Leave empty for zero-config embedded PostgreSQL via PGlite)
DATABASE_URL=
PGLITE_DATA_DIR=.data/vietnomad-pglite

# Public site origin (used for Stripe Checkout return URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Session signing secret (set a strong random string in production)
AUTH_SECRET=vietnomad-dev-secret-change-in-production

# Default locale (en | vi) & commercial demo toggle (false in production; use /admin/demo for QA)
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_DEMO=false

# Stripe Checkout (Cards / Apple Pay / Google Pay)
# Leave empty to run in Sandbox preview mode until keys are provided
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VietQR + SePay / Casso / PayOS Bank Transfer Webhook (VND)
# Example bank BIN: 970422 (MB Bank), 970436 (Vietcombank), 970415 (VietinBank), 970407 (Techcombank)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_WEBHOOK_TOKEN=

# Automated Notifications & Concierge Channels (optional — logged to PostgreSQL automatically)
NEXT_PUBLIC_CONCIERGE_WHATSAPP=84901234567
RESEND_API_KEY=
RESEND_FROM_EMAIL="VietNomad Stays <bookings@vietnomad.stays>"
ADMIN_ALERT_WEBHOOK_URL=
CRON_SECRET=

# Media Storage (Supabase Storage — falls back to local disk /api/uploads when omitted)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stay-photos
