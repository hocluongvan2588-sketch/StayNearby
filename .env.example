# ==============================================================================
# StayNearby — Environment Configuration Example
# Copy this file to `.env.local` and adjust for your environment.
# ==============================================================================

# --- Database (PostgreSQL) ---
# Leave empty in local development to use embedded PostgreSQL (PGlite) stored at .data/staynearby-pglite.
# For Supabase, Vercel Postgres, or external PostgreSQL, set DATABASE_URL (or Vercel's POSTGRES_URL):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
PGLITE_DATA_DIR=.data/staynearby-pglite

# --- Supabase Auth & Storage (optional in local demo mode) ---
# When provided, Supabase Auth and Storage are enabled.
# When omitted, StayNearby runs with its local signed-cookie auth adapter and local storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Session Signing Secret (used by local auth fallback & quote hashes) ---
# Generate a strong random secret in staging/production (min 32 chars).
AUTH_SECRET=staynearby-dev-only-secret-change-before-production-2026

# --- Demo Mode Flag ---
# Set to "true" to label demo data and expose demo quick-sign-in helpers on /login.
# Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE=true

# --- Business & Policy Defaults (pending project owner sign-off for launch) ---
NEXT_PUBLIC_BRAND_NAME=WorkingHome
BOOKING_RESPONSE_TIMEOUT_HOURS=24
DEFAULT_CURRENCY=VND
DEFAULT_USER_COUNTRY=VN
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CANCELLATION_POLICY_VERSION=flexible_24h

# --- Media Storage Limits ---
MAX_LISTING_PHOTOS=12
MAX_PHOTO_SIZE_BYTES=5242880

# --- Operational Workers & Outbox (Phase 3) ---
# Set a strong random secret when exposing /api/internal/jobs/run to external cron.
OPS_SECRET=
OUTBOX_WEBHOOK_URL=
OUTBOX_MAX_ATTEMPTS=5
